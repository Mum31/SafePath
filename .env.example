# SafePath Environment Variables
# Copy to .env and fill values. Never commit .env!

## Frontend (Vercel/Render/Netlify)
VITE_MAPBOX_TOKEN=pk.eyJ1Ijoi...  # https://account.mapbox.com/access-tokens/

VITE_API_URL=http://localhost:8000/api  # Local dev - Update to prod backend URL after deploy

## Backend (Render/Railway)
SECRET_KEY=django-insecure-change-in-prod-...  # Generate: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'

DEBUG=True  # False in production!

# Database (Render Postgres free tier)
DB_NAME=safepath
DB_USER=youruser
DB_PASSWORD=yourpass
DB_HOST=yourdbhost.onrender.com
DB_PORT=5432

# Redis (Render/Upstash free)
REDIS_URL=redis://default:pass@host.redi...

# JWT (optional)
JWT_SECRET_KEY=your-jwt-secret
JWT_ACCESS_TOKEN_LIFETIME_SECONDS=900
JWT_REFRESH_TOKEN_LIFETIME_SECONDS=604800

# Other
ALLOWED_HOSTS=localhost,127.0.0.1,yourapp.onrender.com,yourfrontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourfrontend.vercel.app
